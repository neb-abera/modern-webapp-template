{
  "name": "client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --ssr src/entry-server.tsx && node tools/prerender.mjs",
    "preview": "vite preview",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "generate:api-types": "../tools/api-types/node_modules/.bin/openapi-typescript ../server/Api/openapi.json --output src/api-types.d.ts",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "fast-check": "4.10.2",
    "jsdom": "30.1.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}

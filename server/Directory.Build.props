<Project>
  <PropertyGroup>
    <!-- Must move in lockstep with the dotnet/sdk and dotnet/aspnet image
         tags in the Dockerfile. Dependabot bumps those tags but never this
         property; scripts/check-dotnet-major.sh (run monthly by the
         dotnet-major-upgrade workflow) moves all the sites together. -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-all</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Every project keeps a packages.lock.json, and CI/verify restores run
         with RestoreLockedMode so the packages tested are exactly the ones
         committed — a NuGet mirror can't substitute versions unnoticed.
         Dependabot updates the lock files together with
         Directory.Packages.props. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
</Project>

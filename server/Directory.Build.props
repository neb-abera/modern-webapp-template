<Project>
  <PropertyGroup>
    <!-- Must move in lockstep with the dotnet/sdk and dotnet/aspnet image
         tags in the Dockerfile. Dependabot bumps those tags but never this
         property; scripts/check-dotnet-major.sh (run weekly by the
         dotnet-major-upgrade workflow) moves all the sites together. -->
    <!-- The product version. scripts/check-version.sh holds a release tag
         equal to it, and .versioning names this file as its home. -->
    <Version>2.0.0</Version>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-all</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- The .NET 11 SDK refuses to build under EnforceCodeStyleInBuild
         unless the documentation file is generated, because IDE0005
         (unnecessary usings) needs it. The file is a build output only.
         CS1591 would then ask for an XML comment on every public member. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Every project keeps a packages.lock.json, and CI/verify restores run
         with RestoreLockedMode so the packages tested are exactly the ones
         committed — a NuGet mirror can't substitute versions unnoticed.
         Dependabot updates the lock files together with
         Directory.Packages.props. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
</Project>

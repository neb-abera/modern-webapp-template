# Deploy to Azure Container Apps. Inert until renamed to deploy.yml; the
# one-time Azure setup it depends on is documented in docs/deploying.md.
#
# Repository variables: ACR_LOGIN_SERVER, CONTAINER_APP_NAME, AZURE_RESOURCE_GROUP,
#                       ALLOWED_HOSTS (required), TRUSTED_HOPS (default 0)
# Repository secrets:   AZURE_CLIENT_ID, AZURE_TENANT_ID, AZURE_SUBSCRIPTION_ID,
#                       MIGRATOR_CONNECTION_STRING (once there is a database)
name: deploy

# Only from the default branch, and only once CI has passed on it. Nothing
# reaches the internet that has not been verified.
on:
  workflow_run:
    workflows: [CI]
    branches: [main, master]
    types: [completed]
  # For redeploying the current main without a new commit.
  workflow_dispatch:

# One deploy at a time, never cancelled: a cancelled deploy is half a
# rollout. The group holds one running and one pending run, and a newer run
# replaces the pending one. Checks finish in any order, so the replaced run
# can be for a newer commit than the one that replaces it. Nothing is lost:
# every run deploys the tip of the default branch (the target job), not the
# commit that triggered it.
concurrency:
  group: deploy-production
  cancel-in-progress: false

permissions:
  # Required for the OIDC token azure/login exchanges for credentials; no
  # client secret is stored anywhere.
  id-token: write
  contents: read

jobs:
  # Checks run once per commit, so two merges minutes apart can pass in
  # either order. Deploying the commit that triggered the run would then
  # roll production back to the older one. This job names the tip of the
  # default branch, and only once the tip's own checks have passed. While
  # they are still running it names nothing, and the tip's own run deploys.
  target:
    # workflow_run fires whether or not the checks passed, so a failed run has
    # to be filtered out here rather than assumed away.
    if: >-
      github.event_name == 'workflow_dispatch' ||
      github.event.workflow_run.conclusion == 'success'
    runs-on: ubuntu-latest
    timeout-minutes: 5
    permissions:
      actions: read
      contents: read
    outputs:
      sha: ${{ steps.tip.outputs.sha }}
    steps:
      - name: the tip of the default branch, once its checks passed
        id: tip
        env:
          GH_TOKEN: ${{ github.token }}
          EVENT: ${{ github.event_name }}
          BRANCH: ${{ github.event.repository.default_branch }}
          CHECKS: ${{ github.event.workflow_run.workflow_id }}
        run: |
          set -euo pipefail
          tip=$(gh api "repos/$GITHUB_REPOSITORY/commits/$BRANCH" --jq .sha)
          # A manual redeploy takes the tip as it is.
          if [ "$EVENT" != workflow_dispatch ]; then
            passed=$(gh api "repos/$GITHUB_REPOSITORY/actions/workflows/$CHECKS/runs?head_sha=$tip&status=success" --jq .total_count)
            if [ "$passed" = 0 ]; then
              echo "::notice::$BRANCH is at $tip and its checks have not passed yet. Its own run deploys it."
              exit 0
            fi
          fi
          echo "deploying $tip"
          echo "sha=$tip" >> "$GITHUB_OUTPUT"

  deploy:
    needs: target
    if: needs.target.outputs.sha != ''
    runs-on: ubuntu-latest
    timeout-minutes: 30
    environment: production

    env:
      SHA: ${{ needs.target.outputs.sha }}
      REGISTRY: ${{ vars.ACR_LOGIN_SERVER }}
      CONTAINER_APP: ${{ vars.CONTAINER_APP_NAME }}
      RESOURCE_GROUP: ${{ vars.AZURE_RESOURCE_GROUP }}

    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          # The tip of the default branch, checked, as the target job found it.
          ref: ${{ needs.target.outputs.sha }}
          # This job never pushes to git; don't persist the token.
          persist-credentials: false

      - name: Azure login
        uses: azure/login@a457da9ea143d694b1b9c7c869ebb04ebe844ef5 # v2.2.0
        with:
          client-id: ${{ secrets.AZURE_CLIENT_ID }}
          tenant-id: ${{ secrets.AZURE_TENANT_ID }}
          subscription-id: ${{ secrets.AZURE_SUBSCRIPTION_ID }}

      # Built on the runner and pushed, rather than with `az acr build`, so
      # the deploy identity needs only AcrPush + Reader on the registry.
      # Client-side VITE_* configuration must be passed here as build args:
      # the bundle resolves import.meta.env at build time (docs/deploying.md).
      - name: Build and push the image
        env:
          IMAGE: ${{ github.event.repository.name }}
        run: |
          set -euo pipefail
          az acr login --name "${REGISTRY%%.*}"
          docker build \
            --tag "$REGISTRY/$IMAGE:$SHA" \
            --tag "$REGISTRY/$IMAGE:latest" .
          docker push "$REGISTRY/$IMAGE:$SHA"
          docker push "$REGISTRY/$IMAGE:latest"

      # Schema changes are their own step, as the migrator role, before the
      # new revision exists: the serving app never holds a connection string
      # that can ALTER or DROP (docs/deploying.md, "Databases"). A failure
      # here stops the deploy with the old revision still serving. Skips until
      # the secret exists, so it is safe before there is a database.
      - name: Apply database migrations
        env:
          IMAGE: ${{ github.event.repository.name }}
          MIGRATOR_CONNECTION_STRING: ${{ secrets.MIGRATOR_CONNECTION_STRING }}
        run: |
          set -euo pipefail
          if [ -z "$MIGRATOR_CONNECTION_STRING" ]; then
            echo "::notice::MIGRATOR_CONNECTION_STRING not set; no migrations applied."
            exit 0
          fi
          docker run --rm -e "ConnectionStrings__Default=$MIGRATOR_CONNECTION_STRING" \
            "$REGISTRY/$IMAGE:$SHA" --migrate

      # Deploy the immutable tag: a revision names exactly what it runs, and
      # rollback is redeploying a previous SHA.
      #
      # The two settings only the deployer knows travel with the revision
      # (docs/deploying.md): the host names the app answers to, comma-separated
      # — it serves 400 to anything else, and refuses to start on an empty
      # list, so a missing variable stops here rather than in front of
      # visitors — and how many proxies stand in front of it, which decides
      # whose address the rate limiter sees. /healthz is exempt from the host
      # check, so platform probes and the health gate below need no entry.
      - name: Deploy the revision
        env:
          IMAGE: ${{ github.event.repository.name }}
          ALLOWED_HOSTS: ${{ vars.ALLOWED_HOSTS }}
          TRUSTED_HOPS: ${{ vars.TRUSTED_HOPS || '0' }}
        run: |
          set -euo pipefail
          : "${ALLOWED_HOSTS:?set the ALLOWED_HOSTS repository variable, e.g. www.example.com,example.com}"
          az containerapp update \
            --name "$CONTAINER_APP" \
            --resource-group "$RESOURCE_GROUP" \
            --image "$REGISTRY/$IMAGE:$SHA" \
            --set-env-vars "HostAllowlist__Hosts=$ALLOWED_HOSTS" "ForwardedHeaders__TrustedHops=$TRUSTED_HOPS"

      # `az containerapp update` returns once the revision is created, not
      # once it is serving. Without this a broken deploy looks green.
      - name: Wait for the new revision to be healthy
        run: |
          set -euo pipefail
          fqdn=$(az containerapp show --name "$CONTAINER_APP" \
            --resource-group "$RESOURCE_GROUP" \
            --query 'properties.configuration.ingress.fqdn' -o tsv)
          echo "checking https://$fqdn/healthz"
          for attempt in $(seq 1 30); do
            if curl -sf --max-time 10 "https://$fqdn/healthz" > /dev/null; then
              echo "healthy after $attempt attempt(s)"
              exit 0
            fi
            sleep 10
          done
          echo "revision did not become healthy within five minutes"
          az containerapp logs show --name "$CONTAINER_APP" \
            --resource-group "$RESOURCE_GROUP" --tail 50 || true
          exit 1

  # The CDN edge-caches HTML only if you add a cache rule in the Cloudflare
  # dashboard — and then a deploy must purge, or the edge keeps serving the
  # previous release's pages. The rule and this job only work as a set.
  # Purge-everything rather than a URL list: pages change between releases,
  # and assets are content-hashed so over-purging costs one cache miss each,
  # not correctness. Harmlessly skips when the secrets are unset.
  purge-edge-cache:
    runs-on: ubuntu-latest
    timeout-minutes: 10
    needs: deploy
    steps:
      - name: Purge Cloudflare cache
        env:
          ZONE_ID: ${{ secrets.CLOUDFLARE_ZONE_ID }}
          API_TOKEN: ${{ secrets.CLOUDFLARE_PURGE_TOKEN }}
        run: |
          if [ -z "$ZONE_ID" ] || [ -z "$API_TOKEN" ]; then
            echo "::warning::CLOUDFLARE_ZONE_ID / CLOUDFLARE_PURGE_TOKEN not set; edge cache not purged, stale HTML may be served until it expires."
            exit 0
          fi
          curl --silent --show-error --fail -X POST \
            "https://api.cloudflare.com/client/v4/zones/${ZONE_ID}/purge_cache" \
            -H "Authorization: Bearer ${API_TOKEN}" \
            -H "Content-Type: application/json" \
            --data '{"purge_everything":true}'
